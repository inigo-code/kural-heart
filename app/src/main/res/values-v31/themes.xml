<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 splash: the mark on ivory (Midnight at night). -->
    <style name="Theme.KuralHeart" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ivory</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/ivory</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
    </style>
</resources>
