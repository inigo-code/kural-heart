<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_card">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/w_period" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="@color/w_primary" android:textSize="13sp" android:fontFamily="@font/anek_tamil" android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/w_ref" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/w_ink3" android:textSize="13sp" android:fontFamily="@font/anek_tamil" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_leaf" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="8dp" android:background="@drawable/widget_leaf" android:orientation="vertical"
        android:gravity="center" android:paddingHorizontal="8dp" android:paddingVertical="6dp">
        <TextView android:id="@+id/w_line1" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#2B1E10" android:textSize="16sp" android:fontFamily="@font/anek_tamil" android:maxLines="1" android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="17sp" />
        <TextView android:id="@+id/w_line2" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#2B1E10" android:textSize="16sp" android:fontFamily="@font/anek_tamil" android:maxLines="1" android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="17sp" />
    </LinearLayout>
    <TextView android:id="@+id/w_write" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="10dp"
        android:background="@drawable/widget_button" android:gravity="center" android:textColor="@color/w_on_primary"
        android:textSize="14sp" android:fontFamily="@font/anek_tamil" android:textStyle="bold" />
</LinearLayout>
