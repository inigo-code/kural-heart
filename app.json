{
  "expo": {
    "name": "Kural Heart",
    "slug": "kural-heart",
    "owner": "inigojo",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kuralheart",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.inigocode.kuralheart"
    },
    "android": {
      "package": "com.inigocode.kuralheart",
      "adaptiveIcon": {
        "backgroundColor": "#E5693F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "com.google.android.gms.permission.AD_ID"
      ],
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-blank.png",
          "imageWidth": 160,
          "backgroundColor": "#F6F2EA",
          "dark": {
            "image": "./assets/splash-blank.png",
            "backgroundColor": "#14110F"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/AnekTamil-Regular.ttf",
            "./assets/fonts/AnekTamil-Medium.ttf",
            "./assets/fonts/AnekTamil-SemiBold.ttf",
            "./assets/fonts/AnekTamil-Bold.ttf",
            "./assets/fonts/AnekTamil-Couplet.ttf",
            "./assets/fonts/AnekTamil-CoupletBold.ttf",
            "./assets/fonts/Literata-Regular.ttf",
            "./assets/fonts/Literata-Medium.ttf",
            "./assets/fonts/Literata-SemiBold.ttf",
            "./assets/fonts/Literata-Italic.ttf",
            "./assets/fonts/NotoSerifTamil-Regular.ttf",
            "./assets/fonts/NotoSerifTamil-Medium.ttf",
            "./assets/fonts/NotoSerifTamil-SemiBold.ttf",
            "./assets/fonts/NotoSerifTamil-ExtraBold.ttf"
          ]
        }
      ],
      "expo-sharing",
      "expo-sqlite",
      "expo-image",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Kural Heart uses Face ID to unlock the app when App lock is on."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a",
              "x86_64"
            ]
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kural Heart adds the photos you choose to your pages.",
          "cameraPermission": "Kural Heart takes a photo for your page when you ask."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kural Heart adds the place and weather to a page when you ask.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#B4492A"
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/AnekTamil-Couplet.ttf",
            "./assets/fonts/AnekTamil-SemiBold.ttf"
          ],
          "widgets": [
            {
              "name": "TodayCouplet",
              "label": "Today's couplet",
              "description": "Today's kural on its palm leaf. Never shows your journal.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/icon.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.kural-heart-ios-not-used"
        }
      ],
      "expo-background-task",
      [
        "expo-audio",
        {
          "microphonePermission": "Kural Heart records a voice note for your page when you ask.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "064e944e-040b-415e-a700-b4ff294b67ed"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/064e944e-040b-415e-a700-b4ff294b67ed",
      "checkAutomatically": "NEVER"
    }
  }
}
